DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL=deepseek-v4-pro
ARK_API_KEY=ark-your-ark-api-key
ARK_IMAGE_MODEL=doubao-seedream-4-5-251128
DASHSCOPE_API_KEY=your-dashscope-api-key
WEBGAL_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
WEBGAL_IMAGE_MODEL=doubao-seedream-4-5-251128
WEBGAL_IMAGE_API_KEY_ENV=ARK_API_KEY
WEBGAL_IMAGE_MAX_WORKERS=3
# To use Aliyun Qwen Image instead:
# WEBGAL_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# WEBGAL_IMAGE_MODEL=qwen-image-2.0
# WEBGAL_IMAGE_API_KEY_ENV=DASHSCOPE_API_KEY
LLM_API_MODE=chat
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=MiMo-V2.5-Pro-UltraSpeed
WEBGAL_JOBS_DIR=./jobs
WEBGAL_CONTRACTS_DIR=./webgal_backend/contracts
WEBGAL_ASSET_SCRIPTS_DIR=./asset_scripts
WEBGAL_GENERATION_LIMITS=./webgal_backend/generation_limits.json
WEBGAL_PORT=8010
WEBGAL_MAX_SCHEMA_RETRIES=2
WEBGAL_MAX_TOKENS=
