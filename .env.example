DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL=deepseek-v4-pro
ARK_API_KEY=ark-your-ark-api-key
ARK_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_IMAGE_API_KEY_ENV=DASHSCOPE_API_KEY
WEBGAL_IMAGE_MAX_WORKERS=3
# Qwen Image models selected in the UI share DASHSCOPE_API_KEY.
LLM_API_MODE=chat
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=MiMo-V2.5-Pro-UltraSpeed
MOONSHOT_API_KEY=your-moonshot-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.7-code-highspeed
WEBGAL_JOBS_DIR=./jobs
WEBGAL_CONTRACTS_DIR=./webgal_backend/contracts
WEBGAL_ASSET_SCRIPTS_DIR=./asset_scripts
WEBGAL_GENERATION_LIMITS=./webgal_backend/generation_limits.json
WEBGAL_PORT=8010
# User uploads are persisted to game_assets/public_assets/{job_id}/ on OSS.
WEBGAL_OSS_BUCKET=ecs-oss-ist
WEBGAL_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
WEBGAL_OSS_PREFIX=game_assets/public_assets
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
WEBGAL_AUTH_MODE=sso
WEBGAL_SSO_USERINFO_URL=http://127.0.0.1:3000/api/auth/me
WEBGAL_SSO_COOKIE_NAME=nos_session
# Internal API used for publishing generated games to the public teacher ecosystem.
TEACHER_ECOSYSTEM_API_URL=http://127.0.0.1:3000/api/teacher-ecosystem/internal/works
# Must match TEACHER_ECOSYSTEM_SERVICE_TOKEN on linchangWeb.
TEACHER_ECOSYSTEM_SERVICE_TOKEN=replace-with-a-separate-long-random-string
WEBGAL_MAX_SCHEMA_RETRIES=2
WEBGAL_MAX_ADVANCED_PHASE_RETRIES=2
WEBGAL_MAX_TOKENS=
VITE_GAME_SURVEY_ENABLED=true
VITE_GAME_SURVEY_URL=https://my.feishu.cn/share/base/form/shrcn0hhWX4jndclNCe8nNYCCFf

# Preferred: shared server-side database URL. Percent-encode reserved URL characters.
NARRATIVEOS_DATABASE_URL=mysql://user:password@127.0.0.1:3306/narrativeos_dev

# Alternative: separate connection fields when NARRATIVEOS_DATABASE_URL is absent.
# Never expose any of these values to frontend code.
CREDIT_DB_HOST=127.0.0.1
CREDIT_DB_PORT=3306
CREDIT_DB_USER=narrativeos_app
CREDIT_DB_PASSWORD=
CREDIT_DB_NAME=narrativeos_dev
# Set the CA file in production; certificate verification defaults to true.
CREDIT_DB_SSL_CA=
CREDIT_DB_SSL_VERIFY_CERT=true

# Metered generation pricing. Values are credits, not provider currency.
CREDIT_TEXT_INPUT_PER_MILLION=200
CREDIT_TEXT_OUTPUT_PER_MILLION=800
CREDIT_IMAGE_EACH=10
CREDIT_TTS_PER_THOUSAND_CHARACTERS=5
# Maximum pre-authorization by selected capability; unused credits are released.
CREDIT_TEXT_HOLD=20
CREDIT_IMAGE_HOLD=50
CREDIT_TTS_HOLD=30
