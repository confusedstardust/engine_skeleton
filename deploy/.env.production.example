WEBGAL_FRONTEND_URL=https://your-domain.example.com
BACKEND_PORT=8010
FRONTEND_PORT=3001

DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=MiMo-V2.5-Pro-UltraSpeed
ARK_API_KEY=
ARK_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DASHSCOPE_API_KEY=
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_IMAGE_API_KEY_ENV=DASHSCOPE_API_KEY

# If you have a real mp3 sound-effects directory on the server, point both vars to it.
# Example:
# WEBGAL_SOUND_EFFECTS_DIR=/opt/forge/sound-effects
# WEBGAL_SOUND_EFFECTS_DIR_HOST=/srv/webgal-forge/sound-effects
WEBGAL_SOUND_EFFECTS_DIR=/opt/forge/sound-effects
WEBGAL_SOUND_EFFECTS_DIR_HOST=./deploy/sound-effects

