# Copy to .env in the engine development deployment directory on the Non-Prod server.
BACKEND_PORT=8010
FRONTEND_PORT=3001
WEBGAL_FRONTEND_URL=http://YOUR_SERVER_IP:3001/narrativeos/
WEBGAL_AUTH_MODE=sso
WEBGAL_SSO_USERINFO_URL=http://website:3000/api/auth/me
WEBGAL_SSO_COOKIE_NAME=nos_session

# Use development/test API credentials where available.
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
MIMO_API_KEY=replace-me
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=MiMo-V2.5-Pro-UltraSpeed
ARK_API_KEY=replace-me
ARK_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DASHSCOPE_API_KEY=replace-me
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_IMAGE_API_KEY_ENV=DASHSCOPE_API_KEY

WEBGAL_SOUND_EFFECTS_DIR=/opt/forge/sound-effects
WEBGAL_SOUND_EFFECTS_DIR_HOST=./deploy/sound-effects
