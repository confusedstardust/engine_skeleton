# Copy privately to deploy/nar-agent.env on the server. Never commit real values.
NAR_AGENT_SERVICE_TOKEN=replace-with-the-same-random-token-as-the-root-env
NAR_AGENT_EXECUTION_TOKEN=replace-with-a-different-random-token-at-least-32-chars
NAR_AGENT_API_KEY=
NAR_AGENT_MODEL=deepseek-chat
NAR_AGENT_BASE_URL=https://api.deepseek.com
NAR_AGENT_MAX_CONCURRENT_RUNS=1
NAR_AGENT_ANIMATION_TIMEOUT_SECONDS=600
