# Run from nar_agent/. Never copy production credentials into this file.
NAR_AGENT_SERVICE_TOKEN=replace-with-a-random-token-at-least-32-characters
NAR_AGENT_MODEL=deepseek-flash
NAR_AGENT_BASE_URL=https://api.deepseek.com
NAR_AGENT_API_KEY=
NAR_AGENT_TIMEOUT_SECONDS=120
NAR_AGENT_MAX_OUTPUT_TOKENS=2048
NAR_AGENT_RECURSION_LIMIT=20
NAR_AGENT_MAX_CONCURRENT_RUNS=2
# Enable only after provisioning the separate execution broker and runtime image.
NAR_AGENT_ANIMATION_ENABLED=false
NAR_AGENT_EXECUTION_URL=http://127.0.0.1:8030
NAR_AGENT_EXECUTION_TOKEN=
NAR_AGENT_ARTIFACT_DIR=./artifacts
NAR_AGENT_ANIMATION_TIMEOUT_SECONDS=600

# L1/L2 standalone HTML creation; requires isolated execution broker.
NAR_AGENT_HTML_BUILDER_ENABLED=false
