{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quiz_plan.schema.json",
  "title": "NarrativeOS Review Quiz",
  "type": "object",
  "required": ["title", "introduction", "questions"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "introduction": { "type": "string", "minLength": 1, "maxLength": 300 },
    "questions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "prompt",
          "options",
          "correct_option_ids",
          "explanation",
          "knowledge_point",
          "difficulty",
          "teaching_tip"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^q[1-9][0-9]*$" },
          "type": { "type": "string", "enum": ["single_choice", "judgement"] },
          "prompt": { "type": "string", "minLength": 1, "maxLength": 300 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[A-D]$" },
                "text": { "type": "string", "minLength": 1, "maxLength": 180 }
              }
            }
          },
          "correct_option_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string", "pattern": "^[A-D]$" }
          },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 600 },
          "knowledge_point": { "type": "string", "minLength": 1, "maxLength": 120 },
          "difficulty": { "type": "string", "enum": ["基础", "进阶", "挑战"] },
          "teaching_tip": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    }
  }
}
