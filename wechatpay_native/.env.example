# Keep real secrets out of source control. Use absolute paths outside the repository in production.
WECHATPAY_MCH_ID=1900000001
WECHATPAY_APP_ID=wx0000000000000000
WECHATPAY_MERCHANT_SERIAL_NO=YOUR_MERCHANT_CERTIFICATE_SERIAL
WECHATPAY_MERCHANT_PRIVATE_KEY_PATH=C:\secure\wechatpay\apiclient_key.pem
WECHATPAY_API_V3_KEY=REPLACE_WITH_EXACTLY_32_BYTES
WECHATPAY_PUBLIC_KEY_ID=PUB_KEY_ID_3000000001
WECHATPAY_PUBLIC_KEY_PATH=C:\secure\wechatpay\wechatpay_public_key.pem
WECHATPAY_NOTIFY_URL=https://example.com/api/payments/wechat/notify
WECHATPAY_TIMEOUT_SECONDS=10
WECHATPAY_SIGNATURE_SKEW_SECONDS=300
